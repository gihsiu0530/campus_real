<launch>
    <!-- Localization source: "lidar" (/odom) or "vio" (/vio_odom).
         roslaunch mpcbitch run_mpc.launch localization_source:=vio -->
    <!-- <arg name="localization_source" default="lidar" /> -->
    <arg name="localization_source" default="vio" />
    <!-- Reference path: "planner" (realtime_planner_node, 7-point rolling path)
         or "global" (CSV route on array_topic; start global_path separately).
         Speed profile and waypoint smoothing only act on the global route.
         roslaunch mpcbitch run_mpc.launch path_source:=global
         "vio" localization requires path_source:=planner. -->
    <arg name="path_source" default="planner" />
    <!-- Drive the global CSV route as a closed circuit: at the last waypoint
         the index wraps back to the first one and the node keeps going instead
         of stopping and shutting down. Requires path_source:=global and a CSV
         whose two ends meet (back_garden_07new.csv closes to within 0.16 m).
         roslaunch mpcbitch run_mpc.launch path_source:=global loop_route:=true -->
    <arg name="loop_route" default="false" />
    <!-- <arg name="path_source" default="global" /> -->

    <!-- <node pkg="mpc_4state" type="global_path" name="global_path" output="screen" /> -->
    <param name="CTE_ENTER" value="0.02" />    //0.02
    <param name="CTE_EXIT" value="0.035" />     //0.035

    <param name="EPSI_ENTER" value="0.010" />   //0.005
    <param name="EPSI_EXIT" value="0.025" />    //0.0025

    <param name="DEBOUNCE_CYCLES" value="5" />  //5

    <param name="KAPPA_LOW_SPEED_THRESH" value="0.18" />
    <param name="KAPPA_LOW_SPEED" value="5.0" />

    <!-- Reference path source for mpc_back_test:
         "global"  -> follow global_path.cpp CSV route on array_topic (default).
         "planner" -> follow realtime_planner_node.py on /senpai/array_topic.
         To use "planner": set this to "planner" AND launch realtime_planner_node.py
         separately (needs GPU + model checkpoint, not a catkin node). global_path
         can keep running (now publishes to a different topic, so no collision). -->

    <node pkg="mpcbitch" type="mpc_back_test" name="mpc_back_test" output="screen">
        <!-- Curvature-threshold speed planner lookahead/lookback (used when
             the speed profile is off or in planner mode). Units are path
             POINTS, not metres: on the 0.7 m-spaced CSV route 10 points is 7 m.
             Inside <node>: the code reads them from the ~ namespace.

             WARNING: MIN_LOOKAHEAD / MAX_LOOKAHEAD / LOOKAHEAD_GAIN are read
             into members but mpc_back_test.cpp then computes look_ahead_dist
             from hardcoded locals (10.0 / 30.0 / 10.0), so changing them here
             has NO effect. Only LOOK_BACK_DIST is actually used. -->
        <param name="MIN_LOOKAHEAD" value="5.0" />
        <param name="MAX_LOOKAHEAD" value="30.0" />
        <param name="LOOKAHEAD_GAIN" value="13.0" />
        <param name="LOOK_BACK_DIST" value="5" />

        <!-- Must live inside <node>: the code reads it from the private
             namespace (~path_source), not the global one. -->
        <param name="path_source" value="$(arg path_source)" />

        <!-- Closed-circuit route; see the arg above. Inside <node> for the
             same reason as path_source. -->
        <param name="loop_route" value="$(arg loop_route)" />

        <!-- planner source only: seconds without a new path before the MPC
             commands a stop (v_ref = 0, steering held). The planner
             republishes every 0.5 s, so this is 3 missed inference cycles.
             Inside <node> for the same reason as path_source above. -->
        <param name="PLAN_TIMEOUT" value="1.5" />

        <!-- Forward speed limits (m/s). Inside <node>: read from ~ namespace. -->
        <param name="min_v_forward" value="1.0" />
        <param name="max_v_forward" value="2.5" />
        <!-- Max steering change per control step (rad) -->
        <param name="max_delta_inc" value="0.0084" /> 0.0084

        <!-- Settings validated in simulation (run_mpc_sim.launch).
             Steering deadband off: CTE_ENTER 0 never holds. (The CTE_ENTER at
             the top of this file is a global param the node does not read.) -->
        <param name="CTE_ENTER" value="0.0" />
        <!-- MPC weight on steering change (code default 30) -->
        <param name="R_steer" value="100" />
        <!-- Precomputed speed profile (global route only; planner mode keeps
             the curvature-threshold planner) -->
        <param name="speed_profile" value="true" />
        <param name="speed_profile_steer_rate_frac" value="0.5" />
        <param name="speed_profile_a_lat" value="0.6" />
        <!-- 0.4 for max_v_forward 3.0 ,0.6 for max_v_forward 2.5 -->
        <param name="speed_profile_a_acc" value="0.15" />
        <param name="speed_profile_a_dec" value="0.2" />
        <param name="speed_profile_window" value="3" />
        <!-- Planner path source: re-plan the speed profile on every short
             planner path, ending at min_v_forward, so the car can always brake
             within what the planner can see (~1.5 m/s on a 4.2 m path with
             a_dec 0.15). Curvature over +-2 points: the planner already
             smooths its path. -->
        <param name="planner_speed_profile" value="true" />
        <param name="planner_speed_profile_kappa_baseline" value="2" />
        <!-- Savitzky-Golay waypoint smoothing (global route only) -->
        <param name="path_smooth_window" value="5" />
        <!-- Feedforward variants tested in sim and left off -->
        <param name="ff_lookahead_time" value="0" />
        <param name="clean_feedforward" value="false" />

        <!-- Pose source for the MPC. "vio" requires path_source=planner (the
             CSV route is in the LiDAR map frame; otherwise the node logs an
             ERROR and falls back to lidar). Start separately, e.g. via
             soturon.sh: rosrun mpcbitch vio_pose_to_odom.py (publishes
             /vio_odom) and realtime_planner_node_ff_VIO.py (anchors its path
             on /vio_odom).
             Inside <node> for the same reason as path_source above. -->
        <param name="localization_source" value="$(arg localization_source)" />

        <!-- Slow zone example:
        x/y are map coordinates. target_speed is the speed near that point (m/s).
        approach_distance starts limiting speed before the point.
        leave_distance keeps the low speed briefly after passing the point. -->
        <rosparam param="slow_zones">
        <!-- for campus demo, use the following slow zones: -->
          <!-- - {x: 299.51, y: 100.23, target_speed: 1.0, radius: 1.2, approach_distance: 6.0, leave_distance: 2.0}
          - {x: 68.64, y:  -60.58, target_speed: 1.0, radius: 1.2, approach_distance: 6.0, leave_distance: 2.0}
          - {x: 130.01, y:  155.76, target_speed: 1.0, radius: 1.2, approach_distance: 6.0, leave_distance: 2.0} -->

        </rosparam>
       
        <param name="slow_zones_enabled" value="true" />
        <param name="slow_zone_default_radius" value="1.0" />
        <param name="slow_zone_default_approach_distance" value="3.0" />
        <param name="slow_zone_default_leave_distance" value="1.0" />
    </node>

    <node pkg="mpcbitch" type="plot_cte.py" name="cte_plotter_node" output="screen" />
</launch>
