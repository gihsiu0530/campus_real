<launch>
    <!-- <node pkg="mpc_4state" type="global_path" name="global_path" output="screen" /> -->
    <param name="CTE_ENTER" value="0.02" />    //0.02
    <param name="CTE_EXIT" value="0.035" />     //0.035

    <param name="EPSI_ENTER" value="0.010" />   //0.005
    <param name="EPSI_EXIT" value="0.025" />    //0.0025

    <param name="DEBOUNCE_CYCLES" value="5" />  //5

    <param name="KAPPA_LOW_SPEED_THRESH" value="0.18" />
    <param name="KAPPA_LOW_SPEED" value="5.0" />

    <!-- Speed planning lookahead/lookback parameters -->
    <param name="MIN_LOOKAHEAD" value="5.0" />
    <param name="MAX_LOOKAHEAD" value="30.0" />
    <param name="LOOKAHEAD_GAIN" value="13.0" />
    <param name="LOOK_BACK_DIST" value="4" />

    <!-- Reference path source for mpc_back_test:
         "global"  -> follow global_path.cpp CSV route on array_topic (default).
         "planner" -> follow realtime_planner_node.py on /senpai/array_topic.
         To use "planner": set this to "planner" AND launch realtime_planner_node.py
         separately (needs GPU + model checkpoint, not a catkin node). global_path
         can keep running (now publishes to a different topic, so no collision). -->

    <node pkg="mpcbitch" type="mpc_back_test" name="mpc_back_test" output="screen">
        <!-- Must live inside <node>: the code reads it from the private
             namespace (~path_source), not the global one. -->
        <!-- <param name="path_source" value="global" /> -->
        <param name="path_source" value="planner" />

        <!-- Slow zone example:
        x/y are map coordinates. target_speed is the speed near that point (m/s).
        approach_distance starts limiting speed before the point.
        leave_distance keeps the low speed briefly after passing the point. -->
        <rosparam param="slow_zones">
          <!-- - {x: 299.51, y: 100.23, target_speed: 1.0, radius: 1.2, approach_distance: 6.0, leave_distance: 2.0}
          - {x: 68.64, y:  -60.58, target_speed: 1.0, radius: 1.2, approach_distance: 6.0, leave_distance: 2.0}
          - {x: 130.01, y:  155.76, target_speed: 1.0, radius: 1.2, approach_distance: 6.0, leave_distance: 2.0} -->

        </rosparam>
       
        <param name="slow_zones_enabled" value="true" />
        <param name="slow_zone_default_radius" value="1.0" />
        <param name="slow_zone_default_approach_distance" value="3.0" />
        <param name="slow_zone_default_leave_distance" value="1.0" />
    </node>

    <node pkg="mpcbitch" type="plot_cte.py" name="cte_plotter_node" output="screen" />
</launch>
